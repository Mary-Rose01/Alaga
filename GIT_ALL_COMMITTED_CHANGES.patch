+{% extends 'base.html' %}
+{% block title %}BHW Workload | ALAGA{% endblock %}
+{% block content %}
+<style>
+.page-wrap{max-width:1200px;margin:2rem auto;padding:0 1.25rem;width:100%}.page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem}.page-head h1{font-size:1.8rem;color:#0f172a}.muted{color:#64748b}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.2rem 0}.card,.panel{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:1.2rem;box-shadow:0 2px 5px #0f172a0a}.card strong{display:block;font-size:1.8rem}.layout{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.5fr);gap:1rem}.field{display:flex;flex-direction:column;gap:.4rem;margin:1rem 0}.field select{padding:.7rem;border:1px solid #cbd5e1;border-radius:8px;background:white}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{text-align:left;padding:.8rem;border-bottom:1px solid #e2e8f0}th{font-size:.78rem;color:#64748b;text-transform:uppercase}.empty{text-align:center;padding:1.5rem;color:#64748b}@media(max-width:760px){.grid,.layout{grid-template-columns:1fr}.page-head{display:block}}
+</style>
+<div class="page-wrap"><div class="page-head"><div><h1>BHW Workload & Assignment</h1><p class="muted">Manage active senior citizen assignments across health workers.</p></div><a class="btn btn-secondary" href="{% url 'home' %}">Back to Dashboard</a></div>
+<div class="grid"><div class="card"><span class="muted">Active BHWs</span><strong>{{ total_workers }}</strong></div><div class="card"><span class="muted">Active assignments</span><strong>{{ total_assignments }}</strong></div><div class="card"><span class="muted">Unassigned seniors</span><strong>{{ unassigned_count }}</strong></div></div>
+<div class="layout"><section class="panel"><h2>Assign a senior citizen</h2><p class="muted">Reassigning a senior automatically closes their previous active assignment.</p><form method="post">{% csrf_token %}<div class="field"><label for="senior_id">Senior citizen</label><select id="senior_id" name="senior_id" required><option value="">Choose senior citizen</option>{% for senior in unassigned_seniors %}<option value="{{ senior.pk }}">{{ senior.last_name }}, {{ senior.first_name }}</option>{% endfor %}{% for assignment in assignments %}<option value="{{ assignment.senior_id }}">{{ assignment.senior.last_name }}, {{ assignment.senior.first_name }} (reassign)</option>{% endfor %}</select></div><div class="field"><label for="worker_id">Assign to BHW</label><select id="worker_id" name="worker_id" required><option value="">Choose BHW</option>{% for worker in workers %}<option value="{{ worker.pk }}">{{ worker.get_full_name|default:worker.username }} · {{ worker.active_senior_count }} assigned</option>{% endfor %}</select></div><button class="btn btn-primary" type="submit">Save assignment</button></form></section>
+<section class="panel"><h2>Current assignments</h2><div class="table-wrap"><table><thead><tr><th>Senior citizen</th><th>Barangay</th><th>Assigned BHW</th><th>Assigned date</th></tr></thead><tbody>{% for assignment in assignments %}<tr><td>{{ assignment.senior.last_name }}, {{ assignment.senior.first_name }}</td><td>{{ assignment.senior.barangay|default:'—' }}</td><td>{{ assignment.worker.get_full_name|default:assignment.worker.username }}</td><td>{{ assignment.assigned_at|date:'M d, Y' }}</td></tr>{% empty %}<tr><td colspan="4" class="empty">No active assignments found.</td></tr>{% endfor %}</tbody></table></div></section></div></div>
+{% endblock %}
