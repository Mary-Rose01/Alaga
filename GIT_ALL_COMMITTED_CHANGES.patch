+<section class="panel"><h2>Monthly visits · Last 6 months</h2><div class="table-wrap"><table><thead><tr><th>Month</th><th>Visits</th></tr></thead><tbody>{% for row in monthly_visits %}<tr><td>{{ row.month|date:'F Y' }}</td><td>{{ row.total }}</td></tr>{% empty %}<tr><td colspan="2" class="empty">No visits recorded in this period.</td></tr>{% endfor %}</tbody></table></div><p class="note">Visit totals are based on the visit date recorded in the database.</p></section></div>
