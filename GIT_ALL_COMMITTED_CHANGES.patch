@@ -0,0 +1,15 @@
+{% extends 'base.html' %}
+{% block title %}Reports & Analytics | ALAGA{% endblock %}
+{% block content %}
+<style>
+.page-wrap{max-width:1200px;margin:2rem auto;padding:0 1.25rem;width:100%}.page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem}.page-head h1{font-size:1.8rem;color:#0f172a}.muted{color:#64748b}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:1.2rem 0}.card,.panel{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:1.2rem;box-shadow:0 2px 5px #0f172a0a}.card strong{display:block;font-size:1.8rem}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1rem 0}.bar-row{display:grid;grid-template-columns:minmax(90px,1fr) 2fr 35px;align-items:center;gap:.7rem;margin:.85rem 0;font-size:.88rem}.track{height:10px;border-radius:99px;background:#f1f5f9;overflow:hidden}.fill{height:100%;background:#0f766e;border-radius:99px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{text-align:left;padding:.8rem;border-bottom:1px solid #e2e8f0}th{font-size:.78rem;color:#64748b;text-transform:uppercase}.empty{padding:1.5rem;text-align:center;color:#64748b}.note{font-size:.82rem;color:#64748b;margin-top:.8rem}@media(max-width:800px){.stats{grid-template-columns:repeat(2,1fr)}.two-col{grid-template-columns:1fr}}@media(max-width:450px){.stats{grid-template-columns:1fr}.page-head{display:block}}
+</style>
+<div class="page-wrap"><div class="page-head"><div><h1>Reports & Analytics</h1><p class="muted">A read-only overview calculated from ALAGA's existing records.</p></div><a class="btn btn-secondary" href="{% url 'home' %}">Back to Dashboard</a></div>
