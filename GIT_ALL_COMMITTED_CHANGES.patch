@@ -0,0 +1,16 @@
+{% extends 'base.html' %}
+{% block title %}Health Alerts & Follow-ups | ALAGA{% endblock %}
+{% block content %}
+<style>
+.page-wrap{max-width:1200px;margin:2rem auto;padding:0 1.25rem;width:100%}.page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem}.page-head h1{font-size:1.8rem;color:#0f172a}.muted{color:#64748b}.stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.25rem 0}.stat-card,.panel{background:white;border:1px solid #e2e8f0;border-radius:14px;padding:1.15rem;box-shadow:0 2px 5px #0f172a0a}.stat-card strong{display:block;font-size:1.8rem}.filter-bar{display:flex;gap:.7rem;flex-wrap:wrap;margin-bottom:1rem}.filter-bar input,.filter-bar select{padding:.65rem;border:1px solid #cbd5e1;border-radius:8px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{text-align:left;padding:.85rem;border-bottom:1px solid #e2e8f0;vertical-align:top}th{color:#64748b;font-size:.78rem;text-transform:uppercase}.pill{display:inline-block;border-radius:999px;padding:.2rem .65rem;font-size:.78rem;font-weight:700;background:#f1f5f9}.critical{background:#ffe4e6;color:#be123c}.warning{background:#fef3c7;color:#92400e}.overdue{color:#be123c;font-weight:700}.empty{padding:2rem;text-align:center;color:#64748b}@media(max-width:700px){.stat-grid{grid-template-columns:1fr}.page-head{display:block}}
+</style>
+<div class="page-wrap">
+ <div class="page-head"><div><h1>Health Alerts & Follow-ups</h1><p class="muted">Review health observations and upcoming or overdue follow-ups.</p></div><a class="btn btn-secondary" href="{% url 'home' %}">Back to Dashboard</a></div>
+ <div class="stat-grid"><div class="stat-card"><span class="muted">Critical alerts</span><strong>{{ critical_count }}</strong></div><div class="stat-card"><span class="muted">Warning alerts</span><strong>{{ warning_count }}</strong></div><div class="stat-card"><span class="muted">Overdue follow-ups</span><strong>{{ overdue_count }}</strong></div></div>
+ <section class="panel"><form method="get" class="filter-bar"><input type="search" name="q" value="{{ search_query }}" placeholder="Search senior or alert reason"><select name="level"><option value="">All alert levels</option><option value="Critical" {% if selected_level == 'Critical' %}selected{% endif %}>Critical</option><option value="Warning" {% if selected_level == 'Warning' %}selected{% endif %}>Warning</option><option value="Normal" {% if selected_level == 'Normal' %}selected{% endif %}>Normal</option></select><button class="btn btn-primary" type="submit">Apply filters</button><a class="btn btn-outline" href="{% url 'health_alerts' %}">Clear</a></form>
+ <div class="table-wrap"><table><thead><tr><th>Senior citizen</th><th>Alert</th><th>Reason / observation</th><th>Visit date</th><th>Follow-up</th><th>Recorded by</th></tr></thead><tbody>
+ {% for item in alerts %}<tr><td><strong>{{ item.senior.last_name }}, {{ item.senior.first_name }}</strong><br><span class="muted">{{ item.senior.barangay|default:'Barangay not specified' }}</span></td><td><span class="pill {% if item.alert_level|lower == 'critical' %}critical{% elif item.alert_level|lower == 'warning' %}warning{% endif %}">{{ item.alert_level }}</span></td><td>{{ item.alert_reasons|default:item.symptoms|default:item.notes|default:'No reason recorded'|truncatechars:120 }}</td><td>{{ item.visited_at|date:'M d, Y' }}</td><td>{% if item.follow_up_date %}<span class="{% if item.follow_up_overdue %}overdue{% endif %}">{{ item.follow_up_date|date:'M d, Y' }}{% if item.follow_up_overdue %} · Overdue{% endif %}</span>{% else %}<span class="muted">Not set</span>{% endif %}</td><td>{{ item.worker.get_full_name|default:item.worker.username|default:'—' }}</td></tr>
+ {% empty %}<tr><td colspan="6" class="empty">No health alerts match your filters.</td></tr>{% endfor %}
+ </tbody></table></div></section>
+</div>
+{% endblock %}
